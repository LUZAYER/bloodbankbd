# BloodBond Bangladesh Environment Configuration Example
DATABASE_URL="file:./dev.db" # or postgresql://user:password@localhost:5432/bloodbond?schema=public
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-secret"
NEXT_PUBLIC_APP_NAME="BloodBond Bangladesh"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI & LLM Service Configuration
AI_PROVIDER="rule_based" # 'rule_based', 'openai', or 'gemini'
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Donation Safety & Policy
DEFAULT_SAFETY_INTERVAL_DAYS=90

# Notification Providers
SMS_GATEWAY_PROVIDER="development_mock"
SMS_API_KEY=""
EMAIL_PROVIDER="development_mock"
EMAIL_API_KEY=""
